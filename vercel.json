{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/**",
          "lib/**",
          "src/**",
          "views/**",
          "assets/**",
          "GoMerchant.js",
          "logic-putz.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

