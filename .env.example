# API_KEY_GEMINI: Key untuk Gemini AI Studio (juga kompatibel dengan GEMINI_API_KEY).
API_KEY_GEMINI="YOUR_GEMINI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI official API calls.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENCODE_ZEN_API_KEY: Required for OpenCode Zen official API calls.
OPENCODE_ZEN_API_KEY="YOUR_OPENCODE_ZEN_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
